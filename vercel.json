{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "app.main:app",
      "functions": {
        "**": {
          "excludeFiles": "{botocore/data/!(s3|sts|s3control),**/__pycache__/**,**/*.pyc,**/*.pyo,**/tests/**,**/.pytest_cache/**,boto3/examples/**,botocore/vendored/**}"
        }
      }
    },
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "framework": null
}
