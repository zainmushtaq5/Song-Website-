# --- songs-website backend .env.example ---
APP_NAME="Songs Website API"
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

DATABASE_URL=postgresql+asyncpg://songs:songs@localhost:5432/songs
AUTO_CREATE_TABLES=false

JWT_SECRET=change-me-64-random-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# storage: local (dev) | r2 (prod, Cloudflare R2 via S3 API)
STORAGE_DRIVER=local
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=songs-media
CDN_URL=
LOCAL_STORAGE_DIR=.storage

# rate limiting (Upstash Redis). Leave empty to use in-process limiter (single worker only).
REDIS_URL=

MAX_AUDIO_BYTES=52428800
MAX_COVER_BYTES=5242880
SIGNED_URL_TTL=900
